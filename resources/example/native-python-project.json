  "flows": [
    {
      "id": "flow_connect",
      "name": "打开设备连接",
      "enabled": true,
      "timeoutMs": 30000,
      "nodes": [
        {
          "id": "connect_trigger",
          "kind": "trigger.ui",
          "label": "界面事件",
          "position": {
            "x": 60,
            "y": 130
          },
          "config": {}
        },
        {
          "id": "connect_open",
          "kind": "connection.open",
          "label": "打开连接",
          "position": {
            "x": 310,
            "y": 130
          },
          "config": {
            "connectionId": "sensor"
          }
        }
      ],
      "edges": [
        {
          "id": "edge_1d624066",
          "source": "connect_trigger",
          "sourcePort": "out",
          "target": "connect_open",
          "targetPort": "in"
        }
      ]
    },
    {
      "id": "flow_read",
      "name": "读取温度",
      "enabled": true,
      "timeoutMs": 30000,
      "nodes": [
        {
          "id": "read_trigger",
          "kind": "trigger.ui",
          "label": "界面事件",
          "position": {
            "x": 50,
            "y": 130
          },
          "config": {}
        },
        {
          "id": "read_command",
          "kind": "protocol.command",
          "label": "协议命令",
          "position": {
            "x": 300,
            "y": 130
          },
          "config": {
            "connectionId": "sensor",
            "command": "read",
            "params": {}
          }
        },
        {
          "id": "read_python",
          "kind": "python",
          "label": "NumPy + requests (offline)",
          "position": {
            "x": 550,
            "y": 130
          },
          "config": {
            "code": "def transform(msg):\n    import numpy as np\n    import requests\n\n    raw = np.asarray([msg[\"payload\"][\"rawTemperature\"]], dtype=np.float64)\n    if not bool(np.isfinite(raw).all()):\n        raise ValueError(\"Invalid temperature\")\n    response = requests.Response()\n    response.status_code = 200\n    msg[\"payload\"] = {\n        \"temperature\": float(np.round(raw[0] / 10.0, 1)),\n        \"numpyVersion\": np.__version__,\n        \"requestsVersion\": requests.__version__,\n        \"responseStatus\": response.status_code,\n    }\n    print(\"native dependencies verified:\", msg[\"payload\"])\n    return msg\n",
            "timeoutMs": 5000,
            "memoryMb": 512
          }
        },
        {
          "id": "read_condition",
          "kind": "condition",
          "label": "Valid range",
          "position": {
            "x": 800,
            "y": 130
          },
          "config": {
            "left": {
              "source": "message",
              "path": "payload.temperature"
            },
            "operator": "gte",
            "right": {
              "source": "literal",
              "value": -273.15
            }
          }
        },
        {
          "id": "read_set",
          "kind": "variable.set",
          "label": "写入变量",
          "position": {
            "x": 1050,
            "y": 130
          },
          "config": {
            "variableId": "temperature",
            "value": {
              "source": "message",
              "path": "payload.temperature"
            }
          }
        },
        {
          "id": "read_log",
          "kind": "log",
          "label": "调试日志",
          "position": {
            "x": 1300,
            "y": 130
          },
          "config": {
            "value": {
              "source": "message",
              "path": "payload"
            },
            "level": "info"
          }
        }
      ],
      "edges": [
        {
          "id": "edge_read_0",
          "source": "read_trigger",
          "sourcePort": "out",
          "target": "read_command",
          "targetPort": "in"
        },
        {
          "id": "edge_read_1",
          "source": "read_command",
          "sourcePort": "out",
          "target": "read_python",
          "targetPort": "in"
        },
        {
          "id": "edge_read_2",
          "source": "read_python",
