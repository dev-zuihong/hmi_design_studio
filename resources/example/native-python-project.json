          "targetPort": "in"
        },
        {
          "id": "edge_read_3",
          "source": "read_condition",
          "sourcePort": "true",
          "target": "read_set",
          "targetPort": "in"
        },
        {
          "id": "edge_read_4",
          "source": "read_set",
          "sourcePort": "out",
          "target": "read_log",
          "targetPort": "in"
        }
      ]
    },
