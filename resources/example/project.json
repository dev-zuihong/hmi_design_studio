  "connections": [
    {
      "id": "sensor",
      "name": "温度传感器",
      "port": "sim://temperature",
      "baudRate": 115200,
      "dataBits": 8,
      "stopBits": 1,
      "parity": "none",
      "protocolId": "demo-temperature",
      "protocolVersion": "1.0.0",
      "protocolConfig": {}
    }
  ],
  "variables": [
    {
      "id": "temperature",
      "name": "当前温度",
      "type": "number",
      "initial": 0
    },
    {
      "id": "collecting",
      "name": "采集状态",
      "type": "boolean",
      "initial": false
    }
  ],
  "flows": [
    {
      "id": "flow_connect",
      "name": "打开设备连接",
      "enabled": true,
      "timeoutMs": 30000,
      "nodes": [
        {
          "id": "connect_trigger",
          "kind": "trigger.ui",
          "label": "界面事件",
          "position": {
            "x": 60,
            "y": 130
          },
          "config": {}
        },
        {
          "id": "connect_open",
          "kind": "connection.open",
          "label": "打开连接",
          "position": {
            "x": 310,
            "y": 130
          },
          "config": {
            "connectionId": "sensor"
          }
        }
      ],
      "edges": [
        {
          "id": "edge_1d624066",
          "source": "connect_trigger",
          "sourcePort": "out",
          "target": "connect_open",
          "targetPort": "in"
        }
      ]
    },
    {
      "id": "flow_read",
      "name": "读取温度",
      "enabled": true,
      "timeoutMs": 30000,
      "nodes": [
        {
          "id": "read_trigger",
          "kind": "trigger.ui",
          "label": "界面事件",
          "position": {
            "x": 60,
            "y": 130
          },
          "config": {}
        },
        {
          "id": "read_command",
          "kind": "protocol.command",
          "label": "协议命令",
          "position": {
            "x": 310,
            "y": 130
          },
          "config": {
            "connectionId": "sensor",
            "command": "read",
            "params": {}
          }
        },
        {
          "id": "read_set",
          "kind": "variable.set",
          "label": "写入变量",
          "position": {
            "x": 560,
            "y": 130
          },
          "config": {
            "variableId": "temperature",
            "value": {
              "source": "message",
              "path": "payload.temperature"
            }
          }
        },
        {
          "id": "read_log",
          "kind": "log",
          "label": "调试日志",
          "position": {
            "x": 810,
            "y": 130
          },
          "config": {
            "value": {
              "source": "message",
              "path": "payload"
            },
            "level": "info"
          }
        }
      ],
      "edges": [
        {
          "id": "edge_0c13f3e7",
          "source": "read_trigger",
          "sourcePort": "out",
          "target": "read_command",
          "targetPort": "in"
        },
        {
          "id": "edge_6606aabe",
          "source": "read_command",
          "sourcePort": "out",
          "target": "read_set",
          "targetPort": "in"
        },
        {
          "id": "edge_4723fc70",
          "source": "read_set",
          "sourcePort": "out",
          "target": "read_log",
          "targetPort": "in"
        }
      ]
    },
    {
      "id": "flow_close",
      "name": "关闭设备连接",
      "enabled": true,
      "timeoutMs": 30000,
      "nodes": [
        {
          "id": "close_trigger",
          "kind": "trigger.ui",
          "label": "界面事件",
          "position": {
            "x": 60,
            "y": 130
          },
          "config": {}
        },
        {
          "id": "close_close",
          "kind": "connection.close",
          "label": "关闭连接",
          "position": {
            "x": 310,
            "y": 130
          },
          "config": {
            "connectionId": "sensor"
          }
        }
      ],
      "edges": [
        {
          "id": "edge_1fee3d29",
          "source": "close_trigger",
          "sourcePort": "out",
          "target": "close_close",
          "targetPort": "in"
        }
      ]
    }
