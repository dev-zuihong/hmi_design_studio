{
  "id": "demo-temperature",
  "name": "Temperature controller demo",
  "version": "1.0.0",
  "apiVersion": 1,
  "target": "x86_64-pc-windows-msvc",
  "executable": "demo-protocol.exe",
  "args": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "timeoutMs": {"type": "integer", "minimum": 10, "maximum": 60000, "default": 2000},
      "simulationDelayMs": {"type": "integer", "minimum": 0, "maximum": 30000, "default": 30}
    },
    "additionalProperties": false
  },
  "commands": [
    {"name": "read", "label": "Read temperature", "params": {"type": "object", "additionalProperties": false}},
    {"name": "setTarget", "label": "Set target", "params": {"type": "object", "required": ["target"], "properties": {"target": {"type": "number", "minimum": -40, "maximum": 200}}, "additionalProperties": false}}
  ],
  "points": [
    {"key": "temperature", "label": "Temperature (C)", "type": "number"},
    {"key": "rawTemperature", "label": "Temperature (0.1 C)", "type": "number"},
    {"key": "target", "label": "Target (C)", "type": "number"}
  ]
}
