{
  "name": "hmi-design-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "cd apps/studio && tauri",
    "desktop": "cd apps/studio && tauri dev",
    "check": "vue-tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "build": "npm run check && vite build && vite build --config vite.runner.config.ts",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "build:macos": "bash scripts/build-macos.sh",
    "stage:dev:macos": "bash scripts/stage-dev-macos.sh",
    "desktop:macos": "npm run stage:dev:macos && cd apps/studio && HMI_RESOURCE_ROOT=\"$PWD/../../.cache\" ../../node_modules/.bin/tauri dev",
    "test:native:macos": "node scripts/test-native-macos.mjs",
    "test:native:preview:macos": "bash scripts/test-native-preview-window.sh",
    "verify:package:macos": "python3 scripts/verify-package-macos.py",
    "prepare:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python.ps1",
    "prepare:python:macos": "python3 scripts/prepare-python-macos.py"
  },
  "dependencies": {
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@fluentui/web-components": "3.1.3",
    "@microsoft/fast-element": "3.1.2",
    "@microsoft/focusgroup-polyfill": "1.6.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@zip.js/zip.js": "2.23.0",
    "lucide-vue-next": "1.0.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.14",
    "vue3-moveable": "0.28.0",
    "vue3-selecto": "1.12.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
