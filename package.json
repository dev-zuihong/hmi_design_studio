{
  "name": "hmi-design-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "cd apps/studio && tauri dev",
    "check": "vue-tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "build": "npm run check && vite build && vite build --config vite.runner.config.ts",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "prepare:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python.ps1"
  },
  "dependencies": {
    "vue": "3.5.44",
    "@fluentui/web-components": "3.1.3",
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@microsoft/fast-element": "3.1.2",
    "@microsoft/focusgroup-polyfill": "1.6.0",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/minimap": "1.5.4",
    "vue3-moveable": "0.28.0",
    "vue3-selecto": "1.12.3",
    "lucide-vue-next": "1.0.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@vitejs/plugin-vue": "6.0.10",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vue-tsc": "3.3.13",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "@playwright/test": "1.64.1"
  }
}
